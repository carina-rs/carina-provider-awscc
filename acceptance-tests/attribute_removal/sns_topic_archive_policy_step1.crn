# SNS FIFO Topic archive policy - attribute removal test (step 1)
#
# Tests: create a FIFO topic with ArchivePolicy. The runner plan-verifies the
# native object/number read-back before proceeding to step 2.

provider awscc {
  region = aws.Region.ap_northeast_1
}

awscc.sns.Topic {
  topic_name                   = 'carina-acc-test-sns-archive.fifo'
  fifo_topic                   = true
  content_based_deduplication  = true

  archive_policy = {
    message_retention_period = 1
  }

  tags = {
    Environment = 'acceptance-test'
    Project     = 'carina'
  }
}
