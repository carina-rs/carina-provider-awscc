# WAFv2 WebACL - empty marker objects
#
# Exercises request-field, rate aggregation, and override-action markers whose
# only valid value is an empty struct.

provider awscc {
  region = aws.Region.ap_northeast_1
}

awscc.wafv2.WebAcl {
  name        = 'carina-acc-test-web-acl-markers'
  description = 'Carina acceptance test for WAFv2 empty marker objects'
  scope       = regional

  default_action = {
    allow = {}
  }

  custom_response_bodies = {
    marker_response = {
      content_type = text_plain
      content      = 'Blocked by the Carina WAF marker fixture'
    }
  }

  rule {
    name     = 'uri-path-byte-match'
    priority = 0

    action = {
      block = {
        custom_response = {
          response_code            = 403
          custom_response_body_key = 'marker_response'
        }
      }
    }

    statement = {
      byte_match_statement = {
        search_string         = '/markers'
        positional_constraint = starts_with
        field_to_match        = {
          uri_path = {}
        }
        text_transformation {
          priority = 0
          type     = none
        }
      }
    }

    visibility_config = {
      cloud_watch_metrics_enabled = false
      metric_name                 = 'carinaAccMarkersUriPath'
      sampled_requests_enabled    = false
    }
  }

  rule {
    name     = 'method-byte-match'
    priority = 1

    action = {
      count = {}
    }

    statement = {
      byte_match_statement = {
        search_string         = 'POST'
        positional_constraint = exactly
        field_to_match        = {
          method = {}
        }
        text_transformation {
          priority = 0
          type     = none
        }
      }
    }

    visibility_config = {
      cloud_watch_metrics_enabled = false
      metric_name                 = 'carinaAccMarkersMethod'
      sampled_requests_enabled    = false
    }
  }

  rule {
    name     = 'custom-key-rate-limit'
    priority = 2

    action = {
      count = {}
    }

    statement = {
      rate_based_statement = {
        aggregate_key_type = custom_keys
        limit              = 100

        custom_key {
          ip = {}
        }
        custom_key {
          http_method = {}
        }
      }
    }

    visibility_config = {
      cloud_watch_metrics_enabled = false
      metric_name                 = 'carinaAccMarkersRateLimit'
      sampled_requests_enabled    = false
    }
  }

  rule {
    name     = 'managed-common-rule-set'
    priority = 3

    override_action = {
      none = {}
    }

    statement = {
      managed_rule_group_statement = {
        name        = 'AWSManagedRulesCommonRuleSet'
        vendor_name = 'AWS'
      }
    }

    visibility_config = {
      cloud_watch_metrics_enabled = false
      metric_name                 = 'carinaAccMarkersManagedRules'
      sampled_requests_enabled    = false
    }
  }

  visibility_config = {
    cloud_watch_metrics_enabled = false
    metric_name                 = 'carinaAccTestWebAclMarkers'
    sampled_requests_enabled    = false
  }

  tags = {
    Environment = 'acceptance-test'
  }
}
