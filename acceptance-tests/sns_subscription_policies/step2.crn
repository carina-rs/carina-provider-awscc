# SNS Subscription typed policies - FIFO archive and replay
#
# Queue ARNs and the replay starting point are rendered by run.sh.

provider awscc {
  region = aws.Region.ap_northeast_1
}

let fifo_topic = awscc.sns.Topic {
  topic_name                  = 'carina-acc-test-sns-policies-fifo.fifo'
  fifo_topic                  = true
  content_based_deduplication = true

  archive_policy = {
    message_retention_period = 1
  }

  tags = {
    Environment = 'acceptance-test'
    Project     = 'carina'
  }
}

awscc.sns.Subscription {
  topic_arn            = fifo_topic.topic_arn
  protocol             = 'sqs'
  endpoint             = '__FIFO_QUEUE_ARN__'
  raw_message_delivery = true

  redrive_policy = {
    dead_letter_target_arn = '__FIFO_DLQ_ARN__'
  }

  replay_policy = {
    point_type     = aws.sns.Subscription.ReplayPolicy.PointType.timestamp
    starting_point = '__REPLAY_STARTING_POINT__'
  }
}
