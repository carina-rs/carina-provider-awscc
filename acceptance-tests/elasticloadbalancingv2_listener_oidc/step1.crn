# ElasticLoadBalancingV2 Listener - nested write-only OIDC update
#
# The two suite steps differ only in ssl_policy. The provider must retain the
# nested write-only client_secret in the CloudControl patch base (carina#3984).

provider awscc {
  region = aws.Region.ap_northeast_1
}

let vpc = awscc.ec2.Vpc {
  cidr_block           = '10.23.0.0/16'
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name        = 'carina-acc-test-oidc-vpc'
    Environment = 'acceptance-test'
  }
}

let subnet_a = awscc.ec2.Subnet {
  vpc_id            = vpc.vpc_id
  cidr_block        = '10.23.1.0/24'
  availability_zone = 'ap-northeast-1a'

  tags = {
    Name        = 'carina-acc-test-oidc-subnet-a'
    Environment = 'acceptance-test'
  }
}

let subnet_c = awscc.ec2.Subnet {
  vpc_id            = vpc.vpc_id
  cidr_block        = '10.23.2.0/24'
  availability_zone = 'ap-northeast-1c'

  tags = {
    Name        = 'carina-acc-test-oidc-subnet-c'
    Environment = 'acceptance-test'
  }
}

let alb_sg = awscc.ec2.SecurityGroup {
  vpc_id            = vpc.vpc_id
  group_description = 'Acceptance test OIDC HTTPS listener security group'

  security_group_ingress {
    ip_protocol = tcp
    from_port   = 443
    to_port     = 443
    cidr_ip     = '10.23.0.0/16'
    description = 'Allow VPC HTTPS'
  }

  security_group_egress {
    ip_protocol = all
    cidr_ip     = '10.23.0.0/16'
    description = 'Allow VPC egress'
  }

  tags = {
    Name        = 'carina-acc-test-oidc-alb-sg'
    Environment = 'acceptance-test'
  }
}

let alb = awscc.elasticloadbalancingv2.LoadBalancer {
  name            = 'carina-acc-test-oidc-alb'
  type            = application
  scheme          = internal
  ip_address_type = ipv4
  subnets         = [subnet_a.subnet_id, subnet_c.subnet_id]
  security_groups = [alb_sg.group_id]

  tags = {
    Name        = 'carina-acc-test-oidc-alb'
    Environment = 'acceptance-test'
  }
}

let target_group = awscc.elasticloadbalancingv2.TargetGroup {
  name              = 'carina-acc-test-oidc-tg'
  protocol          = http
  port              = 80
  target_type       = ip
  ip_address_type   = ipv4
  vpc_id            = vpc.vpc_id
  health_check_path = '/'

  tags = {
    Name        = 'carina-acc-test-oidc-tg'
    Environment = 'acceptance-test'
  }
}

awscc.elasticloadbalancingv2.Listener {
  load_balancer_arn = alb.load_balancer_arn
  port              = 443
  protocol          = https
  ssl_policy        = 'ELBSecurityPolicy-TLS13-1-2-2021-06'

  certificate {
    certificate_arn = '__ACM_CERTIFICATE_ARN__'
  }

  default_action {
    order = 1
    type  = authenticate_oidc

    authenticate_oidc_config = {
      issuer                 = 'https://issuer.example.com'
      authorization_endpoint = 'https://issuer.example.com/authorize'
      token_endpoint         = 'https://issuer.example.com/token'
      user_info_endpoint     = 'https://issuer.example.com/userinfo'
      client_id              = 'carina-acc-oidc'
      client_secret          = secret('acc-secret-v1')
    }
  }

  default_action {
    order            = 2
    type             = forward
    target_group_arn = target_group.target_group_arn
  }
}
