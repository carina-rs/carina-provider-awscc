# IAM Identity Center Permission Set Example
#
# Creates a one-hour read-only permission set. This requires the organization's
# existing IAM Identity Center instance.

provider awscc {
  region = awscc.Region.ap_northeast_1
}

awscc.sso.PermissionSet {
  instance_arn     = 'arn:aws:sso:::instance/ssoins-1234567890abcdef'
  name             = 'ExampleReadOnly'
  description      = 'Read-only access for the example workload'
  session_duration = 'PT1H'

  inline_policy = {
    version = aws.iam.PolicyDocument.Version.2012_10_17
    statement {
      effect   = aws.iam.PolicyDocument.Statement.Effect.allow
      action   = 's3:ListAllMyBuckets'
      resource = '*'
    }
  }

  tags = {
    Environment = 'example'
  }
}
