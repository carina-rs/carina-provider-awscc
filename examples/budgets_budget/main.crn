# Budgets Budget Example
#
# AWS Budgets is global; use the us-east-1 Cloud Control endpoint to create a
# monthly cost budget and email the finance team after 80 percent is spent.

provider awscc {
  region = awscc.Region.us_east_1
}

awscc.budgets.Budget {
  budget = {
    budget_limit = {
      amount = 100.0
      unit   = 'USD'
    }

    budget_name  = 'carina-registry-monthly-cost'
    budget_type  = cost
    time_unit    = monthly
  }

  notifications_with_subscribers = [{
    notification = {
      comparison_operator = greater_than
      notification_type   = actual
      threshold           = 80.0
      threshold_type      = percentage
    }

    subscribers  = [{
      address           = 'finance@example.com'
      subscription_type = email
    }]
  }]

  tags = {
    Project = 'carina-registry'
  }
}
