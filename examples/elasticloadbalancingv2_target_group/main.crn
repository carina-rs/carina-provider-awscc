# Elastic Load Balancing v2 Target Group Example
#
# Creates an HTTP IP target group for registry traffic.

provider awscc {
  region = awscc.Region.ap_northeast_1
}

awscc.elasticloadbalancingv2.TargetGroup {
  name              = 'registry-tg'
  protocol          = aws.elasticloadbalancingv2.TargetGroup.Protocol.http
  port              = 8080
  vpc_id            = 'vpc-dddd4444'
  target_type       = aws.elasticloadbalancingv2.TargetGroup.TargetType.ip
  health_check_path = '/health'

  target {
    id   = '10.0.1.10'
    port = 8080
  }

  tags = {
    Environment = 'example'
    Workload    = 'registry'
  }
}
