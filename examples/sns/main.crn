# SNS Topic and Subscription Example
#
# Creates one environment topic, subscribes an email endpoint, and sends both
# CloudWatch alarm and recovery notifications to that topic.

provider awscc {
  region = awscc.Region.ap_northeast_1
}

let alerts = awscc.sns.Topic {
  topic_name   = 'carina-registry-production-alerts'
  display_name = 'Carina production alerts'

  tags = {
    Environment = 'production'
    Project     = 'carina-registry'
  }
}

awscc.sns.Subscription {
  topic_arn = alerts.topic_arn
  protocol  = 'email'
  endpoint  = 'alerts@example.com'
}

awscc.cloudwatch.Alarm {
  alarm_name        = 'carina-registry-production-api-errors'
  alarm_description = 'Registry API Lambda errors'

  comparison_operator = 'GreaterThanThreshold'
  evaluation_periods  = 1
  metric_name         = 'Errors'
  namespace           = 'AWS/Lambda'
  period              = 60
  statistic           = 'Sum'
  threshold           = 0.5

  alarm_actions = [alerts.topic_arn]
  ok_actions    = [alerts.topic_arn]
}
