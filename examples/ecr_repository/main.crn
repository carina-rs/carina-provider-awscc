# ECR Repository Example
#
# Creates a private container image repository with immutable tags,
# scan-on-push, and a lifecycle policy that keeps the last 10 images.

provider awscc {
  region = awscc.Region.ap_northeast_1
}

awscc.ecr.Repository {
  repository_name      = 'registry-publish-api'
  image_tag_mutability = awscc.ecr.Repository.ImageTagMutability.immutable

  image_scanning_configuration = {
    scan_on_push = true
  }

  lifecycle_policy = {
    lifecycle_policy_text = '{"rules":[{"rulePriority":1,"description":"keep last 10 images","selection":{"tagStatus":"any","countType":"imageCountMoreThan","countNumber":10},"action":{"type":"expire"}}]}'
  }

  tags = {
    Environment = 'example'
  }
}
